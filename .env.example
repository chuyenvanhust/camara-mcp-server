BIND_HOST=127.0.0.1
# Public URL may be https://mcp.example.vn/mcp; keep backend port separate.
# Run python scripts/setup.py to generate local secrets into .env.
PORT=3000
MCP_SERVER_URL=http://localhost:3000/mcp
MCP_TOKEN_URL=http://localhost:3000/oauth/token
MCP_CLIENT_ID=local-bridge
MCP_CLIENT_SECRET=GENERATE_WITH_SETUP
MCP_SIGNING_SECRET=GENERATE_WITH_SETUP
MCP_SCOPE=gateway:invoke
GATEWAY_MODULES_FILE=gateway.toml
TOKEN_TTL_SECONDS=600
UPSTREAM_MODE=live
UPSTREAM_TOKEN_URL=https://developers-access.viettel.vn/security-domain/oauth/token
UPSTREAM_CHECK_URL=https://developers-api.viettel.vn/sim-swap/v1/check
UPSTREAM_CLIENT_ID=
UPSTREAM_PRIVATE_KEY_PATH=keys/upstream-private.pem
# Keep empty to sign a fresh JWT for each token request.
UPSTREAM_CLIENT_ASSERTION_PATH=
UPSTREAM_KEY_ID=
UPSTREAM_SIGNING_ALGORITHM=RS256
UPSTREAM_SCOPE=sim-swap sim-swap:check
REQUEST_TIMEOUT_MS=10000
LOG_LEVEL=INFO
LOG_TO_FILE=true

