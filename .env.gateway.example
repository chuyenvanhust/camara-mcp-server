# Example only; replace domain and all credentials before deployment.
BIND_HOST=0.0.0.0
PORT=3000
MCP_SERVER_URL=https://mcp.example.vn/mcp
GATEWAY_MODULES_FILE=gateway.toml
UPSTREAM_MODE=live
UPSTREAM_TOKEN_URL=https://developers-access.viettel.vn/security-domain/oauth/token
UPSTREAM_CHECK_URL=https://developers-api.viettel.vn/sim-swap/v1/check
UPSTREAM_CLIENT_ID=
UPSTREAM_PRIVATE_KEY_PATH=/run/secrets/upstream-private.pem
UPSTREAM_CLIENT_ASSERTION_PATH=
UPSTREAM_KEY_ID=
UPSTREAM_SIGNING_ALGORITHM=RS256
UPSTREAM_SCOPE=sim-swap sim-swap:check
REQUEST_TIMEOUT_MS=10000
